{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "memory": 1024,
        "includeFiles": ["dist/**"]
      }
    },
    {
      "src": "dist/public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/api/index.ts",
      "methods": ["GET"]
    },
    {
      "src": "/ready",
      "dest": "/api/index.ts",
      "methods": ["GET"]
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "src": "/assets/(.*)",
      "dest": "/dist/public/assets/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/images/(.*)",
      "dest": "/dist/public/images/$1",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "src": "/favicon\\.(svg|ico)",
      "dest": "/dist/public/favicon.$1",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg)$)",
      "dest": "/dist/public/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/dist/public/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    }
  ],
  "outputDirectory": "dist/public"
}
