{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "runtime": "vercel-node@20.x"
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/:path*", "destination": "/" }
  ]
}
